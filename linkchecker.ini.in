# LinkChecker configuration for the documentation workflow
# (.github/workflows/documentation.yml).
#
# The site is checked as local files, so absolute links (e.g. /administration/)
# have to be mapped onto the generated _site directory. LinkChecker requires an
# absolute path with a trailing slash here, so linkchecker.sh replaces the
# @LOCALWEBROOT@ placeholder before running LinkChecker.

[checking]
localwebroot=@LOCALWEBROOT@
threads=10
timeout=30
# Limit the number of requests per host, to avoid being rate limited
maxrequestspersecond=5
maxrunseconds=900

[filtering]
# By default LinkChecker only checks internal links
checkextern=1
ignore=
# Hostnames of development and test environments used in examples
  ^https?://(portal|data|eus|public)\.yoda(:\d+)?(/|$)
  ^https?://[^/]*\.yoda\.test(:\d+)?(/|$)
  ^https?://(localhost|127\.0\.0\.1)(:\d+)?(/|$)
# Github rate limiting / web firewall gives too many false positives,
# so just ignore any Github links
  ^https?://github.com(/|$)
  ^https?://camo.githubusercontent.com(/|$)
# Mailto not relevant to check
  ^mailto:
ignorewarnings=url-rate-limited,http-empty-content

[output]
log=text
warnings=1
status=0
