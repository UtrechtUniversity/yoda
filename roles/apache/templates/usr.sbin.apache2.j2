# {{ ansible_managed }}
# Last Modified: Mon Dec  1 16:01:27 2025
include <tunables/global>
# vim:syntax=apparmor
# AppArmor policy for apache2
# No template variables specified


/usr/sbin/apache2 {
  include <abstractions/apache2-common>
  include <abstractions/base>
  include <abstractions/ssl_keys>
  include <abstractions/nameservice>
  include <abstractions/openssl>
  #include <abstractions/bash>
  #include <abstractions/dovecot-common>
  #include <abstractions/nis>
  #include <abstractions/postfix-common>
  #include <abstractions/python>
  #include <abstractions/user-tmp>
  #include <abstractions/web-data>

  capability chown,
  capability kill,

  signal send set=term peer=unconfined,
  signal send set=usr1 peer=unconfined,
  signal send set=winch peer=unconfined,

  deny owner /etc/*.load r,

  /etc/apache2/irods/* r,
  /etc/gss/mech.d/ r,
  /etc/magic r,
  /etc/mime.types r,
  /proc/** r,
  /run/apache2/wsgi.*.sock rw,
  /usr/bin/dash ix,
  /usr/bin/uname mrix,
  /usr/sbin/ldconfig* mrix,
  /var/log/apache2/*.log w,
  /var/run/apache2/ r,
  /var/run/apache2/** rw,
  /var/www/landingpages/** r,
  /var/www/yoda/** r,
  owner /dev/shm/* mrwl,
  {% if enable_anubis %}
  owner /etc/anubis/static-yoda/img/yoda.webp r,
  {% endif %}
  owner /etc/apache2/** r,
  owner /home/yodadeployment/flask_session/ r,
  owner /home/yodadeployment/flask_session/* rw,
  owner /opt/irods-externals/** mr,
  owner /run/apache2/apache2.pid rw,
  owner /run/apache2/apache2.pid.* rw,
  owner /var/lib/davrods rw,
  owner /var/lib/davrods/* rwk,
  owner /var/www/extuser/ r,
  owner /var/www/extuser/** mrw,
  owner /var/www/moai/** mrw,
  owner /var/www/moai/moai.db wk,
  owner /var/www/moai/yoda-moai/moai/__pycache__/* w,
  owner /var/www/webmock/** mr,
  owner /var/www/webmock/log/*.log w,
  owner /var/www/yoda/ r,
  owner /var/www/yoda/** mrw,


  ^DEFAULT_URI {
  }

  ^HANDLING_UNTRUSTED_INPUT {
  }
}
