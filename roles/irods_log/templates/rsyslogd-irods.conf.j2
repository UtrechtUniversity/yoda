# {{ ansible_managed }}

$umask 0000
$WorkDirectory {{ irods_log_directory }}
$FileOwner {{ irods_service_account }}
$FileGroup {{ irods_service_account }}
$FileCreateMode 0644
$DirCreateMode 0755

module(load="omprog")

if (re_match($programname, "^irods(Server|DelayServer|Agent)")) then {
    action(type="omprog" name="transformer" binary="/usr/local/bin/irods-log-transform.py")
    stop
}
