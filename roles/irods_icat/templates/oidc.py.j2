#!/usr/bin/env python3
# {{ ansible_managed }}

import jwt
import requests


OIDC_USERINFO_URI = "{{ oidc_userinfo_uri | default('') }}"
OIDC_EMAIL_FIELD = "{{ oidc_email_field | default('email') }}"
OIDC_CLIENT_ID = "{{ oidc_client_id | default('') }}"
OIDC_JWKS_URI = "{{ oidc_jwks_uri | default('') }}"
OIDC_JWT_ISSUER = "{{ oidc_jwt_issuer | default('') }}"

SRAM_USERINFO_URI = "{{ sram_oidc_userinfo_uri | default('') }}"
SRAM_EMAIL_FIELD = "{{ sram_oidc_email_field | default('email') }}"
SRAM_CLIENT_ID = "{{ sram_oidc_client_id | default('') }}"
SRAM_JWKS_URI = "{{ sram_oidc_jwks_uri | default('') }}"
SRAM_JWT_ISSUER = "{{ sram_oidc_jwt_issuer | default('') }}"

TOKEN_PREFIX_OIDC = '++oidc_token++'
TOKEN_PREFIX_SRAM = '++sram_token++'
SUB_DELIMITER = 'end_sub'
IDT_DELIMITER = 'end_idt'


def verify_id_token(jwks_uri, issuer, client_id, id_token):
    jwks_client = jwt.PyJWKClient(jwks_uri)
    signing_key = jwks_client.get_signing_key_from_jwt(id_token)
    return jwt.decode(
        id_token,
        signing_key.key,
        algorithms=['RS256'],
        audience=client_id,
        issuer=issuer
    )


def validate_token(userinfo_uri, email_field, jwks_uri, issuer, client_id, username, token, id_token, sub):
    try:
        payload = verify_id_token(jwks_uri, issuer, client_id, id_token)
    except jwt.PyJWTError as e:
        print(f"ID token verification failed for {username}: {e}")
        return False
    if payload.get('sub') != sub:
        print(f"Subject mismatch for {username}")
        return False

    # Send token validation request.
    headers = {"Authorization": f"Bearer {token}"}
    try:
        r = requests.get(userinfo_uri, headers=headers, timeout=5)
    except requests.RequestException as e:
        print(f'Failed to connect to userinfo endpoint for {username}: {e}')
        return False

    # Check http status.
    if r.status_code != 200:
        print(f"Failed to get userinfo response for {username}\n{r.status_code}\n{r.text}")
        return False

    # Retrieve token email.
    try:
        email = r.json()[email_field]
        if not isinstance(email, list):
            email = [email]
        email = [x.lower() for x in email]
        userinfo_sub = r.json()['sub']
    except Exception as e:
        print(f"Unable to extract data from the userinfo response for {username}.")
        print(f"Key: {email_field}\nError: {e}")
        return False

    # Check if token email corresponds with username.
    if username in email and sub == userinfo_sub:
        return True

    return False


def parse_token_with_sub(token_data):
    try:
        sub_ix = token_data.index(SUB_DELIMITER)
        sub = token_data[0:sub_ix]
        rest = token_data[sub_ix + len(SUB_DELIMITER):]
    except ValueError:
        return '', token_data, ''
    try:
        idt_ix = rest.index(IDT_DELIMITER)
        return sub, rest[0:idt_ix], rest[idt_ix + len(IDT_DELIMITER):]
    except ValueError:
        return sub, rest, ''


def pam_sm_authenticate(pamh, flags, argv):
    # Get the username.
    try:
        username = pamh.get_user()
    except Exception:
        print("User unknown")
        return pamh.PAM_USER_UNKNOWN

    # Get the token.
    token = pamh.authtok
    if token is None:
        print(f"Missing token for user {username}")
        return pamh.PAM_AUTH_ERR

    # Determine token type and validate.
    if token.startswith(TOKEN_PREFIX_OIDC):
        token_data = token[len(TOKEN_PREFIX_OIDC):]
        sub, actual_token, id_token = parse_token_with_sub(token_data)
        if validate_token(OIDC_USERINFO_URI, OIDC_EMAIL_FIELD, OIDC_JWKS_URI, OIDC_JWT_ISSUER, OIDC_CLIENT_ID, username, actual_token, id_token, sub):
            return pamh.PAM_SUCCESS

    elif token.startswith(TOKEN_PREFIX_SRAM):
        token_data = token[len(TOKEN_PREFIX_SRAM):]
        sub, actual_token, id_token = parse_token_with_sub(token_data)
        if validate_token(SRAM_USERINFO_URI, SRAM_EMAIL_FIELD, SRAM_JWKS_URI, SRAM_JWT_ISSUER, SRAM_CLIENT_ID, username, actual_token, id_token, sub):
            return pamh.PAM_SUCCESS

    else:
        print(f"Not an OIDC token for user {username}")
        return pamh.PAM_PERM_DENIED

    print(f"Validation failed for user {username}")
    return pamh.PAM_AUTH_ERR
