@startuml
!include ../../../theme.puml

left to right direction

rectangle "Yoda instance" {

    package "Yoda web server" {
        rectangle "Apache web server" as portalweb {
            rectangle "Yoda Portal (Python)" as python {
            }
            rectangle "Davrods" as davrods {
            }
	}

        portalweb .d.> provider : Python-irodsclient
    }

    package "iRODS iCAT database" {
        database "PostgreSQL" as icatdb{
            rectangle "iRODS database" as iCAT {
            }
        }
    }

    package "Yoda provider" {
        rectangle "iRODS server (provider)" as provider {
            rectangle "iRODS server" as provider_server {
                rectangle "iRODS rules" as provider_rules {
                }
                rectangle "iRODS microservices" as provider_microservices {
                }
            }
        }

        cloud "Storage P1" as sp1
        cloud "Storage P2" as sp2

        provider_server .d.> iCAT : use
        provider_server .d.> sp1 : use
        provider_server .d.> sp2 : use

    }

    package "Yoda consumer" {
        rectangle "iRODS server (consumer)" as consumer {
            rectangle "iRODS server (consumer)" as consumer_server {
                rectangle "iRODS rules" as consumer_rules {
                }
                rectangle "iRODS microservices" as consumer_microservices {
                }
            }
        }

        cloud "Storage C1" as sc1
        cloud "Storage C2" as sc2

        consumer .r-- provider
        consumer_server .d.> sc1 : use
        consumer_server .d.> sc2 : use

    }

    provider .d.> iCAT : use

}

rectangle "Yoda Public server" {
    rectangle "Apache webserver" as publicweb {
        rectangle "OAI-PMH service" as moai {
        }
    }

    cloud {
      [JSON storage]
    }

    cloud {
      [Landingpages]
    }

    publicweb .d.> [Landingpages]
    moai .d.> [JSON storage]
}

rectangle "Yoda External User Service" {
    rectangle "Apache webserver" as extweb {
        rectangle "Python" as extpy {
        }
    }

    database "PostgreSQL" as extdb {
        rectangle "EUS DB" as extusers {
        }
    }

    extweb .d.> extusers : use
}

HTTPS -- portalweb
HTTPS -r- publicweb
HTTPS -r- extweb
iCommands -- provider_server
iCommands -- consumer_server
provider .d.> [JSON storage] : SCP
provider .d.> [Landingpages] : SCP
provider .d.> extweb : HTTPS-ALT

provider .d.> SMTP
extpy .d.> SMTP

@enduml
