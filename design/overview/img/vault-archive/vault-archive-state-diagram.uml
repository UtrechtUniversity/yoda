@startuml
!include ../../../../theme.puml

state VaultArchive as "Vault Archive" {
  [*] --> ARCHIVING      : Scheduled for archiving
  ARCHIVING --> ARCHIVED : Archiving
  ARCHIVED --> EXTRACT   : Scheduled for unarchiving
  EXTRACT --> EXTRACTING : Unarchiving
  ARCHIVED --> UPDATE    : Scheduled for update
  UPDATE --> UPDATING    : Updating archive
  UPDATING --> ARCHIVED  : Archiving
  EXTRACTING -> [*]
}

@enduml
